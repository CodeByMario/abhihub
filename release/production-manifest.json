  "denylist": [
    {
      "pattern": ".env*",
      "reason": "Live secrets, database passwords, and API keys must never enter runtime artifacts or images."
    },
    {
      "pattern": "firebase-auth.json",
      "reason": "Service account private key; production uses FIREBASE_SERVICE_ACCOUNT_JSON env var."
    },
    {
      "pattern": ".git/**",
      "reason": "Version control history and git internals are not needed at runtime."
    },
    {
      "pattern": ".git*",
