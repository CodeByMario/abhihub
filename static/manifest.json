{
  "id": "/premium",
  "name": "AbhiHub Premium",
  "short_name": "AbhiHub",
  "description": "Your premium academic resource platform for notes, papers, and study materials",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "/static/images/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/images/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/images/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Notes",
      "short_name": "Search",
      "description": "Search for study materials",
      "url": "/premium",
      "icons": [
        {
          "src": "/static/images/android-chrome-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Upload Document",
      "short_name": "Upload",
      "description": "Upload a new document",
      "url": "/upload",
      "icons": [
        {
          "src": "/static/images/android-chrome-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/static/images/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/static/images/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "file_handlers": [
    {
      "action": "/premium/view",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".gif",
          ".webp",
          ".svg"
        ],
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/premium/share-receiver",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "widgets": [
    {
      "name": "Latest Documents",
      "description": "Shows your most recent study materials",
      "tag": "abhihub-widget",
      "ms_ac_template": "widget/template.json",
      "data": "widget/data.json",
      "type": "text/html",
      "screenshots": [
        {
          "src": "/static/images/android-chrome-192x192.png",
          "sizes": "192x192"
        }
      ],
      "icons": [
        {
          "src": "/static/images/android-chrome-192x192.png",
          "sizes": "192x192"
        }
      ],
      "backgrounds": [
        {
          "src": "/static/images/android-chrome-512x512.png"
        }
      ]
    }
  ]
}